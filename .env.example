# For a production host other than Render, provide the exact HTTPS origin.
# On Render, the app uses its trusted RENDER_EXTERNAL_URL automatically.
PUBLIC_ORIGIN=https://your-service.example
DATABASE_URL=postgresql://your-database-connection
OWNER_ACCESS_KEY=replace-with-a-new-random-key-of-at-least-32-characters
NODE_ENV=production
PORT=10000
